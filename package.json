{
  "name": "carpeta-camaleon",
  "version": "1.0.0",
  "description": "Asistente por WhatsApp (chat, notas de voz y llamadas) que maneja Google Workspace con lenguaje natural: Gmail, Calendar, Drive, Docs, Sheets, Tasks y Contactos",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "dev": "node --env-file=.env --watch --import tsx src/index.ts",
    "test": "vitest run",
    "demo": "tsx src/demo.ts",
    "lint": "tsc --noEmit",
    "oauth": "node --env-file=.env --import tsx src/oauth.ts",
    "probar": "node --env-file=.env --import tsx src/probar.ts"
  },
  "author": "Daniel Fajardo",
  "license": "UNLICENSED",
  "dependencies": {
    "@google-cloud/firestore": "^9.4.1",
    "@google/genai": "^3.6.1",
    "express": "^5.3.0",
    "googleapis": "^190.0.0",
    "openai": "^7.64.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
