# Copia este archivo a .env (nunca lo subas al repositorio).
# Lo leen la api (Node) y el servicio de voz (voz/, Python).
# En producción, las variables marcadas [secreto] van en Secret Manager.

PORT=8080
ZONA_HORARIA=America/Bogota

# --- Cerebro: deepseek (por defecto) | gemini ---
LLM_PROVIDER=deepseek

# --- DeepSeek (https://platform.deepseek.com) ---
# [secreto]
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Deepgram (notas de voz y llamadas con DeepSeek: STT nova-3 y TTS aura-2 en español) ---
# [secreto]
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_VOZ=aura-2-celeste-es
# Responder con nota de voz cuando el usuario envía una
RESPONDER_CON_VOZ=true

# --- Gemini (alternativa con LLM_PROVIDER=gemini; AI Studio: https://aistudio.google.com/apikey) ---
# [secreto]
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_VOZ=Kore

# --- WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp) ---
# [secreto] Token de acceso (permanente: usuario del sistema en Business Manager)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
# Número autorizado por defecto si WHATSAPP_NUMEROS_PERMITIDOS está vacío (ej: 573001112233)
WHATSAPP_TEST_NUMBER=
# [secreto] Texto que tú eliges para verificar el webhook
WHATSAPP_VERIFY_TOKEN=
# [secreto] Configuración de la app > Básica > Clave secreta de la app
WHATSAPP_APP_SECRET=
# Números autorizados separados por comas
WHATSAPP_NUMEROS_PERMITIDOS=

# --- Servicio de voz (llamadas de WhatsApp y desde el navegador) ---
# URL del servicio voz vista desde la api (docker compose: http://voz:7860)
VOZ_URL=http://localhost:7860
# URL de la api vista desde el servicio voz (docker compose: http://api:8080)
BACKEND_URL=http://localhost:8080
# [secreto] Clave compartida api <-> voz (openssl rand -hex 32)
VOICE_INTERNAL_KEY=
# [secreto] Token de la página /llamada (openssl rand -hex 16)
LLAMADA_TOKEN=

# --- Google Workspace ---
# OAuth de tu cuenta (necesario para Gmail, Tasks, Contactos y tu Drive/Calendar personal). Cliente "App de escritorio";
# luego `npm run oauth` escribe GOOGLE_OAUTH_REFRESH_TOKEN aquí.
GOOGLE_OAUTH_CLIENT_ID=
# [secreto]
GOOGLE_OAUTH_CLIENT_SECRET=
# [secreto]
GOOGLE_OAUTH_REFRESH_TOKEN=
# Opcionales
DRIVE_CARPETA_ID=
CALENDAR_ID=primary

# --- Estado de la conversación: memoria (local) | firestore (producción) ---
ALMACEN=memoria
FIRESTORE_COLECCION=conversaciones
